# GROQ_API_KEY: Chave da API do Groq para o bot gerador de propostas comerciais personalizadas por nicho.
# Configure no painel Secrets do AI Studio.
GROQ_API_KEY="MY_GROQ_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Chave da API do Google Maps Platform injetada automaticamente.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# GEMINI_API_KEY: Usada como fallback inteligente caso a GROQ_API_KEY ainda não esteja configurada.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde o aplicativo está hospedado.
APP_URL="MY_APP_URL"
