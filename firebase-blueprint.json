{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A local business lead extracted from Google Maps or CNPJ lookup for the Off-Page sales funnel.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated user who owns this lead.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "description": "Official or display name of the business.",
          "minLength": 1,
          "maxLength": 200
        },
        "tradeName": {
          "type": "string",
          "description": "Trade name (Nome Fantasia) from CNPJ.",
          "maxLength": 200
        },
        "cnpj": {
          "type": "string",
          "description": "Formatted or raw 14-digit CNPJ identifier.",
          "maxLength": 30
        },
        "niche": {
          "type": "string",
          "description": "Business category or CNAE niche.",
          "minLength": 1,
          "maxLength": 120
        },
        "address": {
          "type": "string",
          "description": "Full formatted street address.",
          "minLength": 1,
          "maxLength": 400
        },
        "city": {
          "type": "string",
          "description": "City and state.",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Phone or WhatsApp number.",
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "description": "Contact email address.",
          "maxLength": 160
        },
        "responsibleName": {
          "type": "string",
          "description": "Name of the partner or decision maker (Sócio/Responsável).",
          "maxLength": 160
        },
        "websiteStatus": {
          "type": "string",
          "description": "Current digital presence diagnosis.",
          "enum": ["no_website", "outdated_website", "social_only", "active_website"],
          "maxLength": 40
        },
        "websiteUrl": {
          "type": "string",
          "description": "Existing website URL if any.",
          "maxLength": 500
        },
        "googlePlaceId": {
          "type": "string",
          "description": "Google Maps Place ID.",
          "maxLength": 200
        },
        "rating": {
          "type": "number",
          "description": "Google Maps star rating."
        },
        "userRatingCount": {
          "type": "number",
          "description": "Number of Google Maps reviews."
        },
        "lat": {
          "type": "number",
          "description": "Latitude coordinate."
        },
        "lng": {
          "type": "number",
          "description": "Longitude coordinate."
        },
        "funnelStage": {
          "type": "string",
          "description": "Current stage in the sales funnel.",
          "enum": ["extraido", "enriquecido", "proposta_gerada", "proposta_enviada", "em_negociacao", "fechado", "perdido"],
          "maxLength": 40
        },
        "proposalValue": {
          "type": "number",
          "description": "Proposed project value in BRL."
        },
        "proposalWhatsapp": {
          "type": "string",
          "description": "Personalized WhatsApp pitch generated by Groq bot.",
          "maxLength": 4000
        },
        "proposalEmailSubject": {
          "type": "string",
          "description": "Personalized email subject line.",
          "maxLength": 300
        },
        "proposalEmailBody": {
          "type": "string",
          "description": "Personalized commercial proposal body for email/off-page.",
          "maxLength": 8000
        },
        "lastDispatchChannel": {
          "type": "string",
          "description": "Channel used for the latest proposal dispatch.",
          "enum": ["none", "whatsapp", "email", "both"],
          "maxLength": 20
        },
        "lastDispatchStatus": {
          "type": "string",
          "description": "Delivery/engagement status of the latest dispatch.",
          "enum": ["pendente", "enviado", "visualizado", "respondido", "erro"],
          "maxLength": 30
        },
        "notes": {
          "type": "string",
          "description": "Consultant notes and CNPJ QSA/capital details.",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when lead was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when lead was last updated."
        }
      },
      "required": [
        "ownerId",
        "companyName",
        "niche",
        "address",
        "websiteStatus",
        "funnelStage",
        "proposalValue",
        "createdAt",
        "updatedAt"
      ]
    },
    "DispatchLog": {
      "title": "DispatchLog",
      "description": "Audit and monitoring record for each commercial proposal sent via WhatsApp or Email.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated user who triggered the dispatch.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "leadId": {
          "type": "string",
          "description": "Reference ID of the target Lead document.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "description": "Name of the target company.",
          "minLength": 1,
          "maxLength": 200
        },
        "recipientName": {
          "type": "string",
          "description": "Name of the partner or responsible contact.",
          "maxLength": 160
        },
        "recipientContact": {
          "type": "string",
          "description": "Destination phone number or email address.",
          "minLength": 1,
          "maxLength": 160
        },
        "niche": {
          "type": "string",
          "description": "Business niche for analytics.",
          "minLength": 1,
          "maxLength": 120
        },
        "channel": {
          "type": "string",
          "description": "Communication channel used.",
          "enum": ["whatsapp", "email"],
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "description": "Current status of the sent message.",
          "enum": ["enviado", "entregue", "visualizado", "respondido", "erro"],
          "maxLength": 30
        },
        "messagePreview": {
          "type": "string",
          "description": "Sent proposal content.",
          "minLength": 1,
          "maxLength": 4000
        },
        "aiModelUsed": {
          "type": "string",
          "description": "Identifier of the AI model that generated the proposal.",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of dispatch."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last status update."
        }
      },
      "required": [
        "ownerId",
        "leadId",
        "companyName",
        "recipientContact",
        "niche",
        "channel",
        "status",
        "messagePreview",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": {
        "$ref": "#/entities/Lead"
      },
      "description": "Stores extracted local business leads, CNPJ enrichment data, personalized Groq proposals, and funnel stage."
    },
    "/dispatches/{dispatchId}": {
      "schema": {
        "$ref": "#/entities/DispatchLog"
      },
      "description": "Stores automated and manual proposal dispatch logs via WhatsApp and Email for the control panel."
    }
  }
}
